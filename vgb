class _WavePainter extends CustomPainter {
  const _WavePainter();

  @override
  void paint(Canvas canvas, Size size) {
    final w = size.width;
    final h = size.height;

    // Light layer (behind)
    final light = Path()
      ..moveTo(0, h * 0.05)
      ..cubicTo(w * 0.3, h * 0.0, w * 0.55, h * 0.1, w * 0.75, h * 0.06)
      ..cubicTo(w * 0.9, h * 0.03, w, h * 0.07, w, h * 0.12)
      ..lineTo(w, h)
      ..lineTo(0, h)
      ..close();
    canvas.drawPath(light, Paint()..color = AppColors.blueLight);

    // Main blue wave
    final main = Path()
      ..moveTo(0, h * 0.03)
      ..cubicTo(w * 0.25, h * 0.02, w * 0.4, h * 0.12, w * 0.55, h * 0.12)
      ..cubicTo(w * 0.75, h * 0.11, w * 0.85, h * 0.02, w, h * 0.13)
      ..lineTo(w, h)
      ..lineTo(w * 0.55, h)
      ..cubicTo(w * 0.25, h * 0.93, w * 0.08, h * 0.85, 0, h * 0.72)
      ..close();
    canvas.drawPath(
      main.shift(Offset.zero),
      Paint()..color = AppColors.primaryBlue,
    );

    // Soft accent curve on the lower-left
    final accent = Path()
      ..moveTo(0, h * 0.70)
      ..cubicTo(w * 0.06, h * 0.72, w * 0.08, h * 0.82, w * 0.14, h * 0.86)
      ..cubicTo(w * 0.25, h * 0.94, w * 0.42, h * 0.95, w * 0.55, h)
      ..lineTo(w * 0.52, h)
      ..cubicTo(w * 0.28, h * 0.93, w * 0.06, h * 0.84, 0, h * 0.75)
      ..close();
    canvas.drawPath(
      accent,
      Paint()..color = AppColors.blueMid.withOpacity(0.85),
    );
  }

  @override
  bool shouldRepaint(covariant CustomPainter oldDelegate) => false;
}

