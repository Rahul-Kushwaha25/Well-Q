          debugPrint(response.toString());
        } else {
          final reqId = response['message'];
          debugPrint("=======>${mobileController.text}");
          Get.to(()=>VerificationScreen(),arguments: {"verificationId": reqId , "phone":mobileController.text,"isAvailable":isAvailable});
        }
      } else {
        print("Failed to send OTP: $response");
      }
    }catch(e){
