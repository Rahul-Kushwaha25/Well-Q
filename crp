/* ───────────────────────── PASSWORD FIELD ───────────────────────── */

class PasswordField extends StatefulWidget {
  final TextEditingController controller;
  final String hint;
  final FocusNode? focusNode;
  final TextInputAction? textInputAction;
  final ValueChanged<String>? onSubmitted;
  final String? Function(String?)? validator;

  const PasswordField({
    super.key,
    required this.controller,
    required this.hint,
    this.focusNode,
    this.textInputAction,
    this.onSubmitted,
    this.validator,
  });

  @override
  State<PasswordField> createState() => _PasswordFieldState();
}

class _PasswordFieldState extends State<PasswordField> {
  bool _hidden = true;

  @override
  Widget build(BuildContext context) {
    return TextFormField(
      controller: widget.controller,
      focusNode: widget.focusNode,
      obscureText: _hidden,
      textInputAction: widget.textInputAction,
      onFieldSubmitted: widget.onSubmitted,
      validator: widget.validator,
      style: const TextStyle(fontSize: 17),
      decoration: InputDecoration(
        hintText: widget.hint,
        hintStyle: const TextStyle(color: AppColors.textMuted, fontSize: 17),
        filled: true,
        fillColor: Colors.white,
        contentPadding:
            const EdgeInsets.symmetric(horizontal: 18, vertical: 20),
        prefixIcon: const Icon(Icons.lock_outline_rounded),
        suffixIcon: IconButton(
          tooltip: _hidden ? 'Show password' : 'Hide password',
          icon: Icon(_hidden
              ? Icons.visibility_off_rounded
              : Icons.visibility_rounded),
          onPressed: () => setState(() => _hidden = !_hidden),
        ),
        border: OutlineInputBorder(
          borderRadius: BorderRadius.circular(16),
          borderSide: BorderSide.none,
        ),
        errorStyle: const TextStyle(color: Color(0xFFFFD6D6), fontSize: 13),
      ),
    );
  }
}

/* ───────────────────────── LIVE RULES CHECKLIST ───────────────────────── */

class PasswordRules extends StatelessWidget {
  final TextEditingController controller;
  const PasswordRules({super.key, required this.controller});

  @override
  Widget build(BuildContext context) {
    return ValueListenableBuilder<TextEditingValue>(
      valueListenable: controller,
      builder: (_, value, __) {
        final p = value.text;
        return Wrap(
          spacing: 16,
          runSpacing: 6,
          children: [
            _RuleChip(label: '8+ characters', ok: p.length >= 8),
            _RuleChip(label: 'Uppercase', ok: RegExp(r'[A-Z]').hasMatch(p)),
            _RuleChip(label: 'Lowercase', ok: RegExp(r'[a-z]').hasMatch(p)),
            _RuleChip(label: 'Number', ok: RegExp(r'[0-9]').hasMatch(p)),
          ],
        );
      },
    );
  }
}

class _RuleChip extends StatelessWidget {
  final String label;
  final bool ok;
  const _RuleChip({required this.label, required this.ok});

  @override
  Widget build(BuildContext context) {
    return Row(
      mainAxisSize: MainAxisSize.min,
      children: [
        Icon(
          ok ? Icons.check_circle_rounded : Icons.circle_outlined,
          size: 16,
          color: ok ? AppColors.green : Colors.white60,
        ),
        const SizedBox(width: 6),
        Text(
          label,
          style: TextStyle(
            fontSize: 13,
            color: ok ? Colors.white : Colors.white70,
          ),
        ),
      ],
    );
  }
}

