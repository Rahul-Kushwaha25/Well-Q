/* ───────────────────────── SCREEN ───────────────────────── */

class CreatePasswordScreen extends StatefulWidget {
  const CreatePasswordScreen({super.key});

  @override
  State<CreatePasswordScreen> createState() => _CreatePasswordScreenState();
}

class _CreatePasswordScreenState extends State<CreatePasswordScreen> {
  final _formKey = GlobalKey<FormState>();
  final _newPass = TextEditingController();
  final _confirmPass = TextEditingController();
  final _confirmFocus = FocusNode();
  bool _loading = false;

  @override
  void dispose() {
    _newPass.dispose();
    _confirmPass.dispose();
    _confirmFocus.dispose();
    super.dispose();
  }

  Future<void> _submit() async {
    if (!_formKey.currentState!.validate()) return;
    FocusScope.of(context).unfocus();
    setState(() => _loading = true);
    // TODO: call create-password / login API here.
    await Future.delayed(const Duration(seconds: 1));
    if (mounted) setState(() => _loading = false);
  }

  void _showRules() {
    showDialog(
      context: context,
      builder: (_) => AlertDialog(
        shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(20)),
        title: const Text('Password rules'),
        content: Column(
          mainAxisSize: MainAxisSize.min,
          crossAxisAlignment: CrossAxisAlignment.start,
          children: const [
            Text('• At least 8 characters'),
            SizedBox(height: 6),
            Text('• One uppercase letter (A-Z)'),
            SizedBox(height: 6),
            Text('• One lowercase letter (a-z)'),
            SizedBox(height: 6),
            Text('• One number (0-9)'),
          ],
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(context),
            child: const Text('Got it'),
          ),
        ],
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      resizeToAvoidBottomInset: true,
      backgroundColor: AppColors.background,
      body: LoginBackground(
        child: SafeArea(
          child: Column(
            children: [
              Align(
                alignment: Alignment.centerLeft,
                child: Padding(
                  padding: const EdgeInsets.fromLTRB(12, 4, 0, 0),
                  child: RoundBackButton(
                    onTap: () => Navigator.maybePop(context),
                  ),
                ),
              ),
              Expanded(
                child: SingleChildScrollView(
                  keyboardDismissBehavior:
                      ScrollViewKeyboardDismissBehavior.onDrag,
                  padding: const EdgeInsets.only(bottom: 24),
                  child: Column(
                    children: [
                      const SizedBox(height: 16),
                      const SchoolHeader(
                        logoAsset: 'assets/images/logo.png',
                        title: 'CampusCare 10x',
                        location: 'UTTAR PRADESH, NOIDA',
                      ),
                      const SizedBox(height: 70),
                      Padding(
                        padding: const EdgeInsets.symmetric(horizontal: 24),
                        child: Form(
                          key: _formKey,
                          child: Column(
                            children: [
                              SectionTitle(
                                title: 'Create New Password',
                                onInfoTap: _showRules,
                              ),
                              const SizedBox(height: 24),
                              PasswordField(
                                controller: _newPass,
                                hint: 'New Password',
                                textInputAction: TextInputAction.next,
                                onSubmitted: (_) =>
                                    _confirmFocus.requestFocus(),
                                validator: Validators.password,
                              ),
                              const SizedBox(height: 16),
                              PasswordField(
                                controller: _confirmPass,
                                focusNode: _confirmFocus,
                                hint: 'Confirm Password',
                                textInputAction: TextInputAction.done,
                                onSubmitted: (_) => _submit(),
                                validator: (v) {
                                  if (v == null || v.isEmpty) {
                                    return 'Confirm your password';
                                  }
                                  if (v != _newPass.text) {
                                    return 'Passwords do not match';
                                  }
                                  return null;
                                },
                              ),
                              const SizedBox(height: 16),
                              PasswordRules(controller: _newPass),
                              const SizedBox(height: 28),
                              PrimaryButton(
                                label: 'Login',
                                isLoading: _loading,
                                onPressed: _submit,
                              ),
                            ],
                          ),
                        ),
                      ),
                    ],
                  ),
                ),
              ),
              const PoweredByFooter(),
            ],
          ),
        ),
      ),
    );
  }
}

/* ───────────────────────── VALIDATORS ───────────────────────── */

class Validators {
  Validators._();

  static String? password(String? v) {
    if (v == null || v.isEmpty) return 'Enter a new password';
    if (v.length < 8) return 'Use at least 8 characters';
    if (!RegExp(r'[A-Z]').hasMatch(v)) return 'Add an uppercase letter';
    if (!RegExp(r'[a-z]').hasMatch(v)) return 'Add a lowercase letter';
    if (!RegExp(r'[0-9]').hasMatch(v)) return 'Add a number';
    return null;
  }
}

