class FeatureData {
  final String label;
  final IconData icon;
  final Color color;
  const FeatureData(this.label, this.icon, this.color);
}

class FeatureRow extends StatelessWidget {
  final List<FeatureData> items;
  const FeatureRow({super.key, required this.items});

  @override
  Widget build(BuildContext context) {
    return Row(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        for (final item in items) Expanded(child: FeatureItem(data: item)),
      ],
